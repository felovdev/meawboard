{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || newData.hasChildren(['name'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
        "color": { ".validate": "newData.isString() && newData.val().length <= 9" },
        "cursor": {
          "image": { ".validate": "newData.isString() && newData.val().length <= 60000" },
          "$other": { ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()" }
        },
        "prefs": {
          "$other": { ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()" }
        },
        "$other": { ".validate": false }
      }
    },

    "userBoards": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$bid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('boards').child($bid).child('members').child(auth.uid).child('role').val() === 'owner')",
          ".validate": "!newData.exists() || newData.hasChildren(['role'])"
        }
      }
    },

    "invites": {
      "$token": {
        ".read": "auth != null",
        ".write": "auth != null && (newData.exists() ? root.child('boards').child(newData.child('board').val()).child('members').child(auth.uid).child('role').val() === 'owner' : root.child('boards').child(data.child('board').val()).child('members').child(auth.uid).child('role').val() === 'owner')",
        ".validate": "!newData.exists() || (newData.hasChildren(['board', 'role', 'name']) && (newData.child('role').val() === 'edit' || newData.child('role').val() === 'view'))",
        "board": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "role": { ".validate": "newData.isString()" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "ownerName": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "created": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "boards": {
      "$bid": {
        ".write": "auth != null && !newData.exists() && data.child('meta').child('owner').val() === auth.uid",

        "meta": {
          ".read": "auth != null && root.child('boards').child($bid).child('members').child(auth.uid).exists()",
          ".write": "auth != null && (!data.exists() ? newData.child('owner').val() === auth.uid : root.child('boards').child($bid).child('members').child(auth.uid).child('role').val() === 'owner')",
          ".validate": "!newData.exists() || newData.hasChildren(['name', 'owner'])",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
          "owner": { ".validate": "newData.isString()" },
          "ownerName": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "shared": { ".validate": "newData.isBoolean()" },
          "bg": { ".validate": "newData.isString() && newData.val().length <= 9" },
          "grid": { ".validate": "newData.isString() && newData.val().length <= 10" },
          "gridSize": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },

        "members": {
          ".read": "auth != null && root.child('boards').child($bid).child('members').child(auth.uid).exists()",
          "$mid": {
            ".write": "auth != null && ((auth.uid === $mid && !data.exists() && newData.child('role').val() === 'owner' && !root.child('boards').child($bid).child('meta').exists()) || (auth.uid === $mid && newData.child('via').exists() && root.child('invites').child(newData.child('via').val()).child('board').val() === $bid && (!data.exists() || data.child('role').val() === 'viewer') && ((newData.child('role').val() === 'editor' && root.child('invites').child(newData.child('via').val()).child('role').val() === 'edit') || (newData.child('role').val() === 'viewer' && root.child('invites').child(newData.child('via').val()).child('role').val() === 'view'))) || (auth.uid === $mid && !newData.exists()) || root.child('boards').child($bid).child('members').child(auth.uid).child('role').val() === 'owner')",
            ".validate": "!newData.exists() || (newData.hasChildren(['role', 'name']) && (newData.child('role').val() === 'owner' || newData.child('role').val() === 'editor' || newData.child('role').val() === 'viewer'))",
            "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "via": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "role": { ".validate": "newData.isString()" },
            "$other": { ".validate": false }
          }
        },

        "invite": {
          ".read": "auth != null && root.child('boards').child($bid).child('members').child(auth.uid).child('role').val() === 'owner'",
          ".write": "auth != null && root.child('boards').child($bid).child('members').child(auth.uid).child('role').val() === 'owner'"
        },

        "items": {
          ".read": "auth != null && root.child('boards').child($bid).child('members').child(auth.uid).exists()",
          "$iid": {
            ".write": "auth != null && (root.child('boards').child($bid).child('members').child(auth.uid).child('role').val() === 'owner' || root.child('boards').child($bid).child('members').child(auth.uid).child('role').val() === 'editor')",
            ".validate": "!newData.exists() || newData.hasChildren(['type', 'z'])"
          }
        },

        "images": {
          ".read": "auth != null && root.child('boards').child($bid).child('members').child(auth.uid).exists()",
          "$imgId": {
            ".write": "auth != null && (root.child('boards').child($bid).child('members').child(auth.uid).child('role').val() === 'owner' || root.child('boards').child($bid).child('members').child(auth.uid).child('role').val() === 'editor')",
            ".validate": "newData.isString() && newData.val().length <= 900000"
          }
        },

        "presence": {
          ".read": "auth != null && root.child('boards').child($bid).child('members').child(auth.uid).exists()",
          "$pid": {
            ".write": "auth != null && auth.uid === $pid && root.child('boards').child($bid).child('members').child(auth.uid).exists()",
            ".validate": "!newData.exists() || newData.hasChildren(['t'])"
          }
        },

        "updatedAt": {
          ".read": "auth != null && root.child('boards').child($bid).child('members').child(auth.uid).exists()",
          ".write": "auth != null && (root.child('boards').child($bid).child('members').child(auth.uid).child('role').val() === 'owner' || root.child('boards').child($bid).child('members').child(auth.uid).child('role').val() === 'editor')",
          ".validate": "newData.isNumber()"
        },

        "thumb": {
          ".read": "auth != null && root.child('boards').child($bid).child('members').child(auth.uid).exists()",
          ".write": "auth != null && (root.child('boards').child($bid).child('members').child(auth.uid).child('role').val() === 'owner' || root.child('boards').child($bid).child('members').child(auth.uid).child('role').val() === 'editor')",
          ".validate": "newData.isString() && newData.val().length <= 120000"
        }
      }
    }
  }
}
